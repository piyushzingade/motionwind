{
  "name": "motionwind",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/piyushzingade/motionwind.git"
  },
  "bugs": {
    "url": "https://github.com/piyushzingade/motionwind/issues"
  },
  "homepage": "https://github.com/piyushzingade/motionwind#readme",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "bundle:check": "bun scripts/check-bundles.ts",
    "pack:check": "bun scripts/check-packages.ts",
    "registry:check": "bun scripts/validate-registry.ts",
    "corpus:check": "bun scripts/validate-syntax-corpus.ts",
    "compatibility:check": "bun scripts/validate-compatibility.ts",
    "starter:check": "bun scripts/test-starter.ts",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "playwright": "^1.61.1",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "next": "^16.2.6"
  }
}
